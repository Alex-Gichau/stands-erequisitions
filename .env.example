# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SLACK_WEBHOOK_URL: The webhook URL for your Slack channel notifications.
SLACK_WEBHOOK_URL=

# SMTP Configuration for Email Notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Google Sheets Configuration (for Fiscal Isolation & secondary database persistence)
# Set either the complete JSON service account key (base64 encoded or raw string)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Or provide the individual client email and private key credentials explicitly:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Remote MongoDB Database Configuration
MONGODB_URI=
PORT=

# Firebase Auth Configuration (for Supabase Third-Party Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VPS Local Storage Configuration (for Requisition Uploads)
# Files are stored locally in the './uploads' directory of the VPS file system and served via Express on SERVER_PORT.
# Ensure that the 'uploads' directory has write permissions on your VPS.
VPS_IP=
SERVER_PORT=

# Storage & Directory File Paths Configuration
# UPLOADS_DIR: Folder path for uploaded files & converted data URIs
UPLOADS_DIR=./uploads

# DATA_DIR: Folder path for primary JSON database collections
DATA_DIR=./server/data

# BASE_DATA_DIR: Folder path for system logs, backups, and runtime configs
BASE_DATA_DIR=./data

# DIST_DIR: Folder path for production static frontend build output
DIST_DIR=./dist

# GOOGLE_SERVICE_KEY_FILE: Path to Google Service Account JSON key file
GOOGLE_SERVICE_KEY_FILE=./googleService.json

# Valkey / Redis Caching Layer Configuration
# VALKEY_URL: Connection string for Valkey or Redis in-memory data store (e.g. redis://127.0.0.1:6379)
VALKEY_URL=

